<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NnBim: Gestor de Títulos e Numeração" Height="550" Width="850" 
        WindowStartupLocation="CenterScreen" Background="#F4F4F4" Topmost="True">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="EDITAR DETALHES E TÍTULOS" FontWeight="Bold" FontSize="16" Foreground="#2C3E50"/>
            <TextBlock Text="• Altere o Nº Det. para reordenar a lista DESENHO 01-17." Foreground="#7F8C8D"/>
            <TextBlock Text="• Digite o Novo Título. Se deixar VAZIO, o robô usará o Nome da Vista original." Foreground="#7F8C8D"/>
        </StackPanel>

        <DataGrid x:Name="dgVistas" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" 
                  Background="White" BorderBrush="#BDC3C7" HeadersVisibility="Column" VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Prancha" Binding="{Binding Prancha}" IsReadOnly="True" Width="100"/>
                
                <DataGridTextColumn Header="Nº Det." Binding="{Binding NumeroDetalhe}" Width="70">
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="Background" Value="#FEF9E7"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Nome no Revit (Original)" Binding="{Binding NomeVista}" IsReadOnly="True" Width="250"/>

                <DataGridTextColumn Header="Novo Título na Folha (Deixe vazio para usar Nome original)" Binding="{Binding TituloFolha}" Width="*">
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="Background" Value="#E8F8F5"/>
                            <Setter Property="Foreground" Value="Black"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Content="SALVAR TÍTULOS E SINCRONIZAR CARIMBO" Click="salvar_titulos" 
                Height="45" Margin="0,15,0,0" Background="#2980B9" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
    </Grid>
</Window>