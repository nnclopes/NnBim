<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NnBim: Auditoria de Títulos de Vista" Height="500" Width="800" 
        WindowStartupLocation="CenterScreen" Background="#F4F4F4" Topmost="True">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="VISTAS SEM TÍTULO NA FOLHA" FontWeight="Bold" FontSize="16" Foreground="#2C3E50"/>
            <TextBlock Text="Digite o novo título na coluna da direita. O que deixar em branco continuará a usar o Nome da Vista original." Foreground="#7F8C8D" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>

        <DataGrid x:Name="dgVistas" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" 
                  Background="White" RowBackground="#FFFFFF" AlternatingRowBackground="#F9F9F9"
                  BorderBrush="#BDC3C7" BorderThickness="1" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Prancha" Binding="{Binding Prancha}" IsReadOnly="True" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="Margin" Value="5"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                
                <DataGridTextColumn Header="Nome Técnico (Atual)" Binding="{Binding NomeVista}" IsReadOnly="True" Width="300">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="Margin" Value="5"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Novo Título na Folha (Digite Aqui)" Binding="{Binding TituloFolha}" Width="*">
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="Background" Value="#E8F8F5"/>
                            <Setter Property="Padding" Value="2"/>
                            <Setter Property="Foreground" Value="Black"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Black"/>
                            <Setter Property="Margin" Value="5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Content="SALVAR TÍTULOS" Click="salvar_titulos" 
                Height="45" Margin="0,15,0,0" Background="#27AE60" Foreground="White" 
                FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand"/>
    </Grid>
</Window>