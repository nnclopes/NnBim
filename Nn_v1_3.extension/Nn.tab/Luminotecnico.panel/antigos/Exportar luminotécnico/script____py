# PASSO 8 - GRAVAR NOS ROOMS
with Transaction(doc, "NnBim - Iniciar Luminotecnico") as t:
    t.Start()
    for cl in classificacoes:
        room = cl["room"]

        p_alt = room.LookupParameter("LUM_Altura_Luminaria")
        if p_alt and not p_alt.IsReadOnly:
            p_alt.Set(altura_m / 0.3048)

        p_fu = room.LookupParameter("LUM_FU")
        p_fm = room.LookupParameter("LUM_FM")
        if p_fu and not p_fu.IsReadOnly: p_fu.Set(FU_PADRAO)
        if p_fm and not p_fm.IsReadOnly: p_fm.Set(FM_PADRAO)

        if cl["ambiente"]:
            p_em   = room.LookupParameter("LUM_Iluminancia_Em")
            p_dept = room.LookupParameter("Department")
            if p_em and not p_em.IsReadOnly:
                p_em.Set(float(cl["Em"]))
            if p_dept and not p_dept.IsReadOnly:
                grp_txt = cl["ambiente"].get("grupo", "")
                p_dept.Set("{} - {} lux".format(grp_txt, cl["Em"]))
    t.Commit()

