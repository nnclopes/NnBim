<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NnBim: Gestor de Pranchas" Height="550" Width="400" 
        WindowStartupLocation="CenterScreen" Topmost="True" Background="#F5F5F5">
    
    <Grid>
        <TabControl x:Name="MainTabControl" Margin="10">
            <TabItem Header="1. SELEÇÃO">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Selecione as Pranchas (Shift/Ctrl):" FontWeight="Bold" Margin="0,0,0,5"/>
                    
                    <Button Grid.Row="1" Content="MARCAR TODAS (CHECK ALL)" Click="selecionar_todas" 
                            Height="28" Margin="0,5,0,10" Background="#E0E0E0"/>

                    <ListBox x:Name="lbPranchas" Grid.Row="2" SelectionMode="Extended"/>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="CANCELAR" Click="fechar_janela" Width="80" Height="30" Margin="0,0,10,0" Background="#FF7675" Foreground="White"/>
                        <Button Content="PRÓXIMO >" Click="ir_para_dados" Width="100" Height="30" Background="#55E6C1" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="2. DADOS">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <Label Content="Desenhado por:"/>
                        <TextBox x:Name="txtDesenhado" Height="22" Margin="0,0,0,8"/>
                        <Label Content="Projetado por:"/>
                        <TextBox x:Name="txtProjetado" Height="22" Margin="0,0,0,8"/>
                        <Label Content="Verificado por:"/>
                        <TextBox x:Name="txtVerificado" Height="22" Margin="0,0,0,15"/>
                        
                        <Separator/>
                        
                        <Label Content="Disciplina:"/>
                        <TextBox x:Name="txtDisciplina" Height="22" Margin="0,5,0,8"/>
                        <Label Content="Data Emissão:"/>
                        <TextBox x:Name="txtDataEmissao" Height="22" Margin="0,0,0,8"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <Label Content="Revisão:"/><TextBox x:Name="txtRevisao" Height="22"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <Label Content="Data Rev.:"/><TextBox x:Name="txtDataRevisao" Height="22"/>
                            </StackPanel>
                        </Grid>

                        <Label Content="Fase do Projeto:" Margin="0,8,0,0"/>
                        <TextBox x:Name="txtFase" Height="22" Margin="0,0,0,20"/>

                        <Button Content="ATUALIZAR CARIMBOS" Click="executar_atualizacao" 
                                Height="40" Background="#0984E3" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>